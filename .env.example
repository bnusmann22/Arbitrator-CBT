# ============================================================
# Arbitration Sandbox — Environment Variable Reference
# ============================================================
#
# LOCAL DEVELOPMENT
#   Copy → apps/api/.env            (backend)
#   Copy → apps/web/.env.local      (frontend)
#
# PRODUCTION
#   API (Fly.io):  flyctl secrets set KEY="value"
#   Web (Vercel):  Vercel dashboard → Settings → Environment Variables
# ============================================================

# ── Firebase (API only) ──────────────────────────────────────────────────────
# Same values for local and production — both point to the same Firebase project.

FIREBASE_PROJECT_ID=arbritator-sandbox
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@arbritator-sandbox.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_STORAGE_BUCKET=arbritator-sandbox.appspot.com

# NOTE: Do NOT wrap FIREBASE_PRIVATE_KEY in quotes in the .env file.
# The loader converts \n to real newlines. Quoting causes CRLF issues on Windows.

# ── JWT (must be IDENTICAL in API and Web) ───────────────────────────────────

JWT_SECRET=your-64-char-hex-secret-here
JWT_EXPIRATION=3600

# ── API server ───────────────────────────────────────────────────────────────

PORT=4000

# CORS_ORIGIN — the frontend URL that is allowed to call the API
#   Local dev:   CORS_ORIGIN=http://localhost:3000
#   Production:  CORS_ORIGIN=https://arbitrator-cbt.vercel.app

CORS_ORIGIN=http://localhost:3000

# ── Frontend (NEXT_PUBLIC_ vars are baked into the browser bundle) ───────────

#   Local dev:   NEXT_PUBLIC_API_URL=http://localhost:4000/api
#   Production:  NEXT_PUBLIC_API_URL=https://arbitration-sandbox-api.fly.dev/api

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=Arbitration Sandbox
